generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  posts       Post[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  posts     PostTag[]
  microPosts MicroPostTag[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Post {
  id           String      @id @default(cuid())
  title        String
  slug         String      @unique
  summary      String?
  markdown     String
  coverImage   String?
  status       PostStatus  @default(DRAFT)
  publishedAt  DateTime?
  categoryId   String?
  category     Category?   @relation(fields: [categoryId], references: [id])
  tags         PostTag[]
  likes        PostLike[]
  comments     Comment[]
  likeCount    Int         @default(0)
  commentCount Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model MicroPost {
  id          String         @id @default(cuid())
  content     String
  status      PostStatus     @default(DRAFT)
  publishedAt DateTime?
  tags        MicroPostTag[]
  likes       MicroPostLike[]
  likeCount   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model MediaAsset {
  id        String   @id @default(cuid())
  url       String   @unique
  pathname  String   @unique
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PostTag {
  postId String
  tagId  String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model MicroPostTag {
  microPostId String
  tagId       String
  microPost   MicroPost @relation(fields: [microPostId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([microPostId, tagId])
}

model Comment {
  id        String        @id @default(cuid())
  postId    String
  nickname  String
  content   String
  status    CommentStatus @default(APPROVED)
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model GuestbookEntry {
  id        String        @id @default(cuid())
  nickname  String
  content   String
  status    CommentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model VisitLog {
  id        String   @id @default(cuid())
  path      String
  referer   String?
  ipSummary String
  country   String?
  region    String?
  city      String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}

model PostLike {
  id         String   @id @default(cuid())
  postId     String
  visitorKey String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([postId, visitorKey])
}

model MicroPostLike {
  id          String    @id @default(cuid())
  microPostId String
  visitorKey  String
  microPost   MicroPost @relation(fields: [microPostId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([microPostId, visitorKey])
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}
