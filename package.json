{
  "name": "next-refactor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "node -e \"require('node:fs').rmSync('.next-prod', { recursive: true, force: true })\" && prisma generate && next build",
    "start": "next start",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.checkjs.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node --env-file=.env prisma/seed.mjs",
    "db:test:migrate": "node --env-file=.env --env-file=.env.test scripts/prepare-test-database.mjs",
    "db:cleanup:test-data": "node --env-file=.env --env-file=.env.test scripts/cleanup-test-data.mjs",
    "db:import:legacy-photos": "node --experimental-default-type=module --env-file=.env scripts/import-legacy-photos.mjs"
  },
  "dependencies": {
    "@arayui/rainy-day": "^1.0.6",
    "@iarna/toml": "^2.2.5",
    "@prisma/client": "^6.6.0",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "@vercel/blob": "^2.3.1",
    "autoprefixer": "^10.4.27",
    "bcryptjs": "^3.0.2",
    "framer-motion": "^12.34.3",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.575.0",
    "maplibre-gl": "^5.19.0",
    "next": "^15.2.0",
    "postcss": "^8.5.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "jsdom": "^26.1.0",
    "prisma": "^6.6.0",
    "vitest": "^3.2.4"
  }
}
